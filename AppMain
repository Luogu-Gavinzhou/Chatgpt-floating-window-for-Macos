
import AppKit
import SwiftUI
import WebKit

// MARK: - App

@main
struct ChatFloatApp: App {
    @NSApplicationDelegateAdaptor(ChatFloatAppDelegate.self)
    var appDelegate

    var body: some Scene {
        Settings {
            EmptyView()
        }
    }
}

// MARK: - App Delegate

final class ChatFloatAppDelegate: NSObject, NSApplicationDelegate {
    private var controller: ChatFloatWindowController?

    func applicationDidFinishLaunching(_ notification: Notification) {
        controller = ChatFloatWindowController()
        controller?.showFloatingBall()
    }

    func applicationShouldTerminateAfterLastWindowClosed(
        _ sender: NSApplication
    ) -> Bool {
        false
    }
}

// MARK: - Persistent State

final class FloatingState: ObservableObject {
    static let shared = FloatingState()

    @Published var isExpanded = false

    private let defaults = UserDefaults.standard

    var expandedWidth: CGFloat {
        get {
            let v = defaults.double(forKey: "expandedWidth")
            return v > 0 ? CGFloat(v) : 760
        }
        set {
            defaults.set(Double(newValue), forKey: "expandedWidth")
        }
    }

    var expandedHeight: CGFloat {
        get {
            let v = defaults.double(forKey: "expandedHeight")
            return v > 0 ? CGFloat(v) : 620
        }
        set {
            defaults.set(Double(newValue), forKey: "expandedHeight")
        }
    }

    var ballX: CGFloat {
        get {
            defaults.object(forKey: "ballX") == nil
                ? 100 : CGFloat(defaults.double(forKey: "ballX"))
        }
        set {
            defaults.set(Double(newValue), forKey: "ballX")
        }
    }

    var ballY: CGFloat {
        get {
            defaults.object(forKey: "ballY") == nil
                ? 500 : CGFloat(defaults.double(forKey: "ballY"))
        }
        set {
            defaults.set(Double(newValue), forKey: "ballY")
        }
    }
}

// MARK: - ChatGPT Web View

final class WebViewStore {
    static let shared = WebViewStore()

    let webView: WKWebView
    private var loaded = false

    private init() {
        let configuration = WKWebViewConfiguration()
        configuration.websiteDataStore = .default()

        webView = WKWebView(
            frame: .zero,
            configuration: configuration
        )
        webView.allowsBackForwardNavigationGestures = true
    }

    func loadIfNeeded() {
        guard !loaded else { return }
        loaded = true

        if let url = URL(string: "https://chatgpt.com") {
            webView.load(URLRequest(url: url))
        }
    }
}

struct PersistentWebView: NSViewRepresentable {
    func makeNSView(context: Context) -> WKWebView {
        let view = WebViewStore.shared.webView
        WebViewStore.shared.loadIfNeeded()
        return view
    }

    func updateNSView(_ nsView: WKWebView, context: Context) {}
}

// MARK: - Borderless Panel

final class ChatFloatPanel: NSPanel {
    override var canBecomeKey: Bool { true }
    override var canBecomeMain: Bool { false }

    override var hidesOnDeactivate: Bool {
        get { false }
        set {}
    }
}

// MARK: - Window Controller

final class ChatFloatWindowController:
    NSWindowController,
    NSWindowDelegate
{
    private let state = FloatingState.shared

    private let ballSize: CGFloat = 32

    private let minimumWidth: CGFloat = 340
    private let minimumHeight: CGFloat = 280

    private let maximumWidth: CGFloat = 1100
    private let maximumHeight: CGFloat = 900

    private var savedBallOrigin: NSPoint?
    private var isChangingSize = false

    init() {
        let screen = NSScreen.main ?? NSScreen.screens[0]
        let visible = screen.visibleFrame

        let initialOrigin = NSPoint(
            x: visible.minX + 40,
            y: visible.midY
        )

        let panel = ChatFloatPanel(
            contentRect: NSRect(
                origin: initialOrigin,
                size: NSSize(width: ballSize, height: ballSize)
            ),
            styleMask: [.borderless, .resizable],
            backing: .buffered,
            defer: false
        )

        super.init(window: panel)

        configurePanel(panel)

        panel.contentView = NSHostingView(
            rootView: FloatingRootView(controller: self)
        )

        panel.setContentSize(
            NSSize(width: ballSize, height: ballSize)
        )

        let restored = NSPoint(x: state.ballX, y: state.ballY)
        let origin = clampBallOrigin(restored, on: screen)

        panel.setFrameOrigin(origin)
        savedBallOrigin = origin
        panel.orderFrontRegardless()
    }

    required init?(coder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }

    private func configurePanel(_ panel: ChatFloatPanel) {
        panel.delegate = self

        panel.level = .floating
        panel.isFloatingPanel = true
        panel.isReleasedWhenClosed = false
        panel.hidesOnDeactivate = false

        panel.collectionBehavior = [
            .canJoinAllSpaces,
            .fullScreenAuxiliary,
            .stationary
        ]

        panel.backgroundColor = .clear
        panel.hasShadow = true
        panel.isMovableByWindowBackground = false

        // 无标题栏，不显示红黄绿按钮
        panel.title = ""
        panel.titleVisibility = .hidden
        panel.titlebarAppearsTransparent = true

        panel.minSize = NSSize(width: ballSize, height: ballSize)
        panel.maxSize = NSSize(width: ballSize, height: ballSize)
    }

    // 将悬浮球限制在屏幕可见范围，但不吸附边缘
    private func clampBallOrigin(
        _ origin: NSPoint,
        on screen: NSScreen
    ) -> NSPoint {
        let visible = screen.visibleFrame

        return NSPoint(
            x: min(
                max(origin.x, visible.minX),
                max(visible.minX, visible.maxX - ballSize)
            ),
            y: min(
                max(origin.y, visible.minY),
                max(visible.minY, visible.maxY - ballSize)
            )
        )
    }

    // 显示悬浮球
    func showFloatingBall() {
        guard let panel = window else { return }

        state.isExpanded = false
        panel.minSize = NSSize(width: ballSize, height: ballSize)
        panel.maxSize = NSSize(width: ballSize, height: ballSize)

        panel.setContentSize(
            NSSize(width: ballSize, height: ballSize)
        )

        let screen = panel.screen ?? NSScreen.main ?? NSScreen.screens[0]
        let origin = clampBallOrigin(
            NSPoint(x: state.ballX, y: state.ballY),
            on: screen
        )

        panel.setFrameOrigin(origin)
        savedBallOrigin = origin
        panel.orderFrontRegardless()
    }

    // 展开窗口
    func expand() {
        guard let panel = window, !state.isExpanded else { return }

        savedBallOrigin = panel.frame.origin
        state.isExpanded = true

        let width = min(
            max(state.expandedWidth, minimumWidth),
            maximumWidth
        )

        let height = min(
            max(state.expandedHeight, minimumHeight),
            maximumHeight
        )

        panel.minSize = NSSize(
            width: minimumWidth,
            height: minimumHeight
        )
        panel.maxSize = NSSize(
            width: maximumWidth,
            height: maximumHeight
        )

        let screen = panel.screen ?? NSScreen.main ?? NSScreen.screens[0]
        let visible = screen.visibleFrame
        let ballOrigin = savedBallOrigin ?? panel.frame.origin

        let x = min(
            max(ballOrigin.x + ballSize / 2 - width / 2, visible.minX),
            max(visible.minX, visible.maxX - width)
        )

        let y = min(
            max(ballOrigin.y + ballSize / 2 - height / 2, visible.minY),
            max(visible.minY, visible.maxY - height)
        )

        isChangingSize = true
        panel.setFrame(
            NSRect(x: x, y: y, width: width, height: height),
            display: true
        )
        isChangingSize = false

        panel.makeKeyAndOrderFront(nil)
    }

    // 收起窗口
    func collapse() {
        guard let panel = window, state.isExpanded else { return }

        // 保存展开窗口大小
        state.expandedWidth = min(
            max(panel.frame.width, minimumWidth),
            maximumWidth
        )
        state.expandedHeight = min(
            max(panel.frame.height, minimumHeight),
            maximumHeight
        )

        state.isExpanded = false

        let screen = panel.screen ?? NSScreen.main ?? NSScreen.screens[0]
        let origin = clampBallOrigin(
            savedBallOrigin ?? NSPoint(x: state.ballX, y: state.ballY),
            on: screen
        )

        panel.minSize = NSSize(width: ballSize, height: ballSize)
        panel.maxSize = NSSize(width: ballSize, height: ballSize)

        isChangingSize = true
        panel.setFrame(
            NSRect(
                origin: origin,
                size: NSSize(width: ballSize, height: ballSize)
            ),
            display: true
        )
        isChangingSize = false

        state.ballX = origin.x
        state.ballY = origin.y
        savedBallOrigin = origin

        panel.orderFrontRegardless()
    }

    // 移动窗口
    func moveWindow(by delta: CGSize) {
        guard let panel = window else { return }

        var origin = panel.frame.origin
        origin.x += delta.width
        origin.y -= delta.height

        panel.setFrameOrigin(origin)
    }

    // 悬浮球松开后停在当前位置，不吸附
    func snapBallToEdge() {
        guard let panel = window else { return }

        let screen = panel.screen ?? NSScreen.main ?? NSScreen.screens[0]
        let origin = clampBallOrigin(panel.frame.origin, on: screen)

        panel.setFrameOrigin(origin)

        state.ballX = origin.x
        state.ballY = origin.y
        savedBallOrigin = origin
    }

    // 保存展开尺寸
    func windowDidResize(_ notification: Notification) {
        guard
            !isChangingSize,
            state.isExpanded,
            let panel = window
        else { return }

        state.expandedWidth = min(
            max(panel.frame.width, minimumWidth),
            maximumWidth
        )
        state.expandedHeight = min(
            max(panel.frame.height, minimumHeight),
            maximumHeight
        )
    }
}

// MARK: - Root View

struct FloatingRootView: View {
    let controller: ChatFloatWindowController

    @ObservedObject private var state = FloatingState.shared

    var body: some View {
        Group {
            if state.isExpanded {
                expandedContent
            } else {
                FloatingBallControl(controller: controller)
                    .frame(width: 32, height: 32)
            }
        }
        .frame(
            minWidth: state.isExpanded ? 340 : 32,
            maxWidth: .infinity,
            minHeight: state.isExpanded ? 280 : 32,
            maxHeight: .infinity
        )
    }

    private var expandedContent: some View {
        VStack(spacing: 0) {
            HStack(spacing: 8) {
                // 只有标题文字区域可拖动
                Text("ChatFloat")
                    .font(.system(size: 12, weight: .medium))
                    .foregroundStyle(.secondary)
                    .frame(height: 32)
                    .gesture(
                        DragGesture()
                            .onChanged { value in
                                controller.moveWindow(
                                    by: CGSize(
                                        width: value.translation.width
                                            - dragState.lastTranslation.width,
                                        height: value.translation.height
                                            - dragState.lastTranslation.height
                                    )
                                )
                                dragState.lastTranslation = value.translation
                            }
                            .onEnded { _ in
                                dragState.lastTranslation = .zero
                            }
                    )

                Spacer(minLength: 8)

                // 独立按钮，不受拖动手势覆盖
                Button {
                    controller.collapse()
                } label: {
                    Image(systemName: "minus")
                        .font(.system(size: 13, weight: .medium))
                        .frame(width: 32, height: 28)
                        .contentShape(Rectangle())
                }
                .buttonStyle(.plain)
                .help("收起悬浮窗")
            }
            .padding(.horizontal, 10)
            .frame(height: 34)
            .background(Color(nsColor: .windowBackgroundColor))

            PersistentWebView()
                .frame(
                    minWidth: 0,
                    maxWidth: .infinity,
                    minHeight: 0,
                    maxHeight: .infinity
                )
        }
        .background(Color(nsColor: .windowBackgroundColor))
    }

    @State private var dragState = DragState()
}

private struct DragState {
    var lastTranslation: CGSize = .zero
}

// MARK: - Floating Ball

struct FloatingBallControl: NSViewRepresentable {
    let controller: ChatFloatWindowController

    func makeNSView(context: Context) -> FloatingBallNSView {
        let view = FloatingBallNSView()

        view.onClick = {
            controller.expand()
        }

        view.onDrag = { delta in
            controller.moveWindow(by: delta)
        }

        view.onDragEnd = {
            controller.snapBallToEdge()
        }

        return view
    }

    func updateNSView(
        _ nsView: FloatingBallNSView,
        context: Context
    ) {}
}

final class FloatingBallNSView: NSView {
    var onClick: (() -> Void)?
    var onDrag: ((CGSize) -> Void)?
    var onDragEnd: (() -> Void)?

    private var downPoint: NSPoint = .zero
    private var lastPoint: NSPoint = .zero
    private var didDrag = false

    override var acceptsFirstResponder: Bool { true }

    override func draw(_ dirtyRect: NSRect) {
        super.draw(dirtyRect)

        // 完整绘制 32 × 32 的圆形
        let circleRect = bounds.insetBy(dx: 0.5, dy: 0.5)
        let circle = NSBezierPath(ovalIn: circleRect)

        NSColor(
            red: 0.12,
            green: 0.45,
            blue: 0.95,
            alpha: 1
        ).setFill()

        circle.fill()

        let paragraph = NSMutableParagraphStyle()
        paragraph.alignment = .center

        let attributes: [NSAttributedString.Key: Any] = [
            .font: NSFont.systemFont(ofSize: 15, weight: .bold),
            .foregroundColor: NSColor.white,
            .paragraphStyle: paragraph
        ]

        let text = NSAttributedString(
            string: "C",
            attributes: attributes
        )

        let size = text.size()

        text.draw(
            in: NSRect(
                x: bounds.midX - size.width / 2,
                y: bounds.midY - size.height / 2,
                width: size.width,
                height: size.height
            )
        )
    }

    override func mouseDown(with event: NSEvent) {
        downPoint = convert(event.locationInWindow, from: nil)
        lastPoint = downPoint
        didDrag = false
    }

    override func mouseDragged(with event: NSEvent) {
        let point = convert(event.locationInWindow, from: nil)

        if abs(point.x - downPoint.x) > 3 ||
            abs(point.y - downPoint.y) > 3 {
            didDrag = true
        }

        guard didDrag else { return }

        let delta = CGSize(
            width: point.x - lastPoint.x,
            height: point.y - lastPoint.y
        )

        onDrag?(delta)
        lastPoint = point
    }

    override func mouseUp(with event: NSEvent) {
        if didDrag {
            onDragEnd?()
        } else {
            onClick?()
        }
    }
}
